{
  "name": "traveller-chargen",
  "type": "module",
  "engines": {
  	"node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format src test *.config.ts",
    "lint": "biome lint src test *.config.ts",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "@ksilvennoinen/markov-namegen": "^2.0.0",
    "@ksilvennoinen/urw-classico": "^1.0.0",
    "@ksilvennoinen/urw-classicsans": "^1.0.0",
    "@picocss/pico": "^2.0.6",
    "@svgdotjs/svg.js": "^3.2.0",
    "pure-rand": "^8.4.2",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
